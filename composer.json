{
    "name": "mrdellimore/laravel-sheet-stream",
    "description": "Streaming Excel imports & exports for Laravel, powered by OpenSpout.",
    "keywords": ["laravel", "excel", "xlsx", "csv", "openspout", "streaming", "import", "export", "memory"],
    "license": "MIT",
    "authors": [
        { "name": "Andrew M. Dellimore", "email": "andrewdellimore@gmail.com" }
    ],
    "require": {
        "php": "^8.3",
        "ext-zip": "*",
        "ext-xmlreader": "*",
        "openspout/openspout": "^4.30",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "phpoffice/phpspreadsheet": "^2.0 || ^3.0 || ^4.0",
        "laravel/pint": "^1.20",
        "larastan/larastan": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "phpoffice/phpspreadsheet": "Required for the phpspreadsheet engine driver (.xls support, formula evaluation, charts)"
    },
    "autoload": {
        "psr-4": { "MrDellimore\\SheetStream\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MrDellimore\\SheetStream\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["MrDellimore\\SheetStream\\SheetStreamServiceProvider"],
            "aliases": { "SheetStream": "MrDellimore\\SheetStream\\Facades\\SheetStream" }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
